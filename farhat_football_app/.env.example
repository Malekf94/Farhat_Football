# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored —
# never commit real secrets.
#
# SECRET values (leave blank for collaborators / dev — get from the owner or
# use your own dev credentials): DATABASE_URL, AUTH0_CLIENT_SECRET,
# MONZO_*, BREVO_*.
# ---------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
PORT=3000
# Where the frontend and backend are reachable (localhost for dev)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# --- Database ---
# A Postgres connection string. Use your OWN local/staging DB for dev —
# do NOT use the production database.
DATABASE_URL=postgres://user:password@localhost:5432/farhat_football

# --- Auth0 (use a DEV Auth0 application for local work) ---
# These four are compiled into the frontend bundle by Vite and are not secret.
VITE_AUTH0_DOMAIN=your-tenant.uk.auth0.com
VITE_AUTH0_CLIENT_ID=your_dev_client_id
# NOT frontend-only. Apis/auth/checkJwt.cjs reads this at REQUIRE time, so the
# API needs it in its own runtime environment as well as at build time. Without
# it the server throws "An 'audience' is required to validate the 'aud' claim"
# while loading modules and never reaches app.listen — on a host that reads a
# port to decide the deploy succeeded, that looks like "no open ports detected"
# rather than a missing variable.
VITE_AUTH0_AUDIENCE=https://your-api-audience
VITE_API_BASE_URL=http://localhost:3000

# Backend Auth0 config
AUTH0_DOMAIN=your-tenant.uk.auth0.com
AUTH0_CLIENT_ID=your_dev_client_id
AUTH0_CLIENT_SECRET=          # SECRET — dev app's secret, or leave blank
AUTH0_REDIRECT_URI=http://localhost:5173
# Custom claim the Login Action adds so the API can identify the caller.
# Only needed while accounts are still being claimed: identity is the immutable
# `sub` claim, and email is read once, to bind an existing account to it.
AUTH0_EMAIL_CLAIM=https://farhatfootball.co.uk/email
# Optional. Names the custom claim carrying email_verified, if the Login Action
# adds one. When the claim is present and false, an account is NOT claimed by
# that address (AUTH-001). Leave unset and the standard `email_verified` claim
# is used if the token carries it; absent entirely means the check cannot run.
AUTH0_EMAIL_VERIFIED_CLAIM=

# The default portal's slug (your original site)
DEFAULT_HOST_SLUG=farhat

# --- Monzo (payments) — leave blank in dev; payments just won't fire ---
MONZO_ACCESS_TOKEN=       # SECRET — never share the production token
MONZO_ACCOUNT_ID=

# --- Brevo (emails) — leave blank in dev; emails just won't send ---
BREVO_API_KEY=            # SECRET
BREVO_FROM_EMAIL=
