{
	"name": "farhat_football_app",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"start": "node server.cjs",
		"dev": "concurrently \"npm run server\" \"npm run client\"",
		"server": "nodemon server.cjs",
		"client": "vite",
		"build": "vite build",
		"lint": "eslint . --max-warnings 5",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:integration": "vitest run --config vitest.integration.config.js",
		"migrate": "node scripts/migrate.cjs up",
		"migrate:status": "node scripts/migrate.cjs status",
		"migrate:provision": "node scripts/migrate.cjs provision",
		"migrate:baseline": "node scripts/migrate.cjs baseline"
	},
	"dependencies": {
		"@auth0/auth0-react": "^2.2.4",
		"@getbrevo/brevo": "^5.0.4",
		"axios": "^1.7.7",
		"cors": "^2.8.5",
		"date-fns": "^4.1.0",
		"dotenv": "^16.4.7",
		"express": "^4.21.1",
		"express-oauth2-jwt-bearer": "^1.9.0",
		"helmet": "^8.0.0",
		"pg": "^8.13.1",
		"prop-types": "^15.8.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^7.18.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^6.1.0",
		"concurrently": "^9.1.0",
		"eslint": "^9.13.0",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.0.0",
		"eslint-plugin-react-refresh": "^0.4.14",
		"globals": "^15.11.0",
		"nodemon": "^3.1.14",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
